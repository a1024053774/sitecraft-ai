      "hero": {
        "title": {
          "zh": "精密注塑模具与注塑件",
          "en": "Precision injection molds and molded parts"
        },
        "subtitle": {
          "zh": "模具设计、试模到批量注塑在同一厂区完成，内销与出口订单并行。",
          "en": "Mold design, trial molding and volume production run in one plant, serving domestic and export orders."
        },
        "cta": {
          "zh": "提交图纸获取报价",
          "en": "Submit drawings for a quote"
        }
      },
      "about": {
        "title": {
          "zh": "关于我们",
          "en": "About us"
        },
        "body": {
          "zh": "宁海精密注塑模具P3T 从事塑料注塑模具设计制造与精密注塑件生产。工厂有模具车间和注塑车间，按图纸或样品开模，并承接批量注塑。内销与出口订单并行，出口以欧洲和东南亚为主。",
          "en": "Ninghai Precision Injection Mold P3T designs and builds plastic injection molds and produces precision molded parts. The plant has a mold shop and a molding shop, builds molds from drawings or samples, and takes on volume molding. Domestic and export orders run in parallel, with exports mainly to Europe and Southeast Asia."
        }
      },
      "features": {
        "title": {
          "zh": "优势",
          "en": "Advantages"
        },
        "intro": {
          "zh": "待补充",
