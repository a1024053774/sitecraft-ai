        },
        "items": [
          {
            "id": "one-plant",
            "title": {
              "zh": "模具与注塑同一厂区",
              "en": "Mold shop and molding shop in one plant"
            },
            "body": {
              "zh": "工厂有模具车间和注塑车间，模具设计、试模到批量注塑在同一厂区完成。",
              "en": "The plant has a mold shop and a molding shop; mold design, trial molding and volume production are completed in the same plant."
            }
          },
          {
            "id": "drawings-samples",
            "title": {
              "zh": "按图纸或样品开模",
              "en": "Molds from drawings or samples"
            },
            "body": {
              "zh": "可按图纸开模，只有样品时先做 3D 扫描和逆向建模，图纸确认后再开模。",
              "en": "Molds can be built from drawings; with only a sample, 3D scanning and reverse modeling come first, and mold making starts after the drawing is confirmed."
            }
          },
          {
            "id": "domestic-export",
            "title": {
              "zh": "内销与出口并行",
              "en": "Domestic and export orders in parallel"
            },
            "body": {
              "zh": "内销与出口订单并行，出口以欧洲和东南亚为主。",
              "en": "Domestic and export orders run in parallel, with exports mainly to Europe and Southeast Asia."
            }
          }
        ]
