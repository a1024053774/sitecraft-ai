# 复制为 gitignore 的 .env.local 后按需修改。只列代码实际读取的变量。

# 存储：不设或设为 fs 时，开发模式把对话与批注存在本地文件。
# postgres：对话与批注存 PostgreSQL（需要 DATABASE_URL）。
# browser：站点长期副本只在访客浏览器（T-202），必须另设临时 SITECRAFT_DATA_ROOT。
# 注意：生产模式（NODE_ENV=production）下，只要不是 browser，对话与批注一律走 PostgreSQL。
# 站点代码、版本、资料与上传始终在 SITECRAFT_DATA_ROOT（默认 .sitecraft-data/）。
SITE_STORE=fs
# SITECRAFT_DATA_ROOT=.sitecraft-data
DEFAULT_WORKSPACE_ID=demo

# 模型接口（仅开发与测试读取；生产模式只用访客在浏览器里填写的接口）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash
# AI_BASE_URL、AI_API_KEY、AI_MODEL 是上面三项的备用名，DEEPSEEK_* 优先
# 接口格式：deepseek（默认）、openai、anthropic。选后两种时，上面三项填对应服务商的地址、key 和模型名
# AI_PROVIDER_FORMAT=deepseek

# PostgreSQL（SITE_STORE=postgres 或生产模式时）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/site_studio
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 浏览器存储模式（SITE_STORE=browser）的服务器副本与队列，以下为默认值
# SITECRAFT_SESSION_IDLE_MS=1800000
# SITECRAFT_SESSION_CAP_BYTES=134217728
# SITECRAFT_BUNDLE_LIMIT_BYTES=20971520
# SITECRAFT_QUEUE_WAITING=3

# 访客模型接口回复的大小上限（字节）
# SITECRAFT_PROVIDER_RESPONSE_LIMIT_BYTES=16777216
# 本机验收的生产构建连接本地模型替身时才设为 1；公网服务不得设置
# SITECRAFT_ALLOW_LOCAL_PROVIDER=

# 提交检查用的 headless Chrome；检查页从本服务的 /code-check.html 载入，
# 地址默认 http://127.0.0.1:$PORT（PORT 默认 3000）
# CHROME_PATH=/path/to/chrome-headless-shell
# SITECRAFT_BASE=http://127.0.0.1:3000
# （SITECRAFT_TEST_*、NODE_TEST_CONTEXT 由 npm test 入口自行设置，不写在这里）
# 把检查浏览器的 CDP 调用诊断写到此目录（排查用）
# SITECRAFT_CHECK_DIAGNOSTICS_DIR=

# 英文翻译的 token 上限与单次输出上限（可选）
# SITE_CODE_TRANSLATION_TOKEN_LIMIT=
# SITE_CODE_TRANSLATION_OUTPUT_LIMIT=16000

# 评估时经原 chat 门禁开放的 pending 风格编号，逗号分隔（见 lib/code-site-styles.ts）
# SITECRAFT_EVAL_STYLES=
